<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | BLACKPINK Fan Management System</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/members.css" />
    <link rel="stylesheet" href="/css/portal.css" />
  </head>
  <body class="dashboard-page">
    <div class="dashboard-layout">
      <%- include('../partials/member-sidebar', { active: 'profile' }) %>
      <div class="dashboard-content">
        <header class="dashboard-header"><span>My fan community</span><span class="header-role">Member</span></header>
        <main class="dashboard-main">
          <a class="back-link" href="/member">← Back to home</a>
          <% if (notice) { %><p class="success-message" role="status"><%= notice %></p><% } %>
          <section class="content-card profile-card">
            <div class="profile-top">
              <% if (profile.profile_picture_url) { %><img class="profile-photo" src="<%= profile.profile_picture_url %>" alt="Profile of <%= profile.first_name %> <%= profile.last_name %>" referrerpolicy="no-referrer" /><% } else { %><span class="profile-placeholder" aria-hidden="true"><%= profile.first_name.slice(0, 1).toUpperCase() %><%= profile.last_name.slice(0, 1).toUpperCase() %></span><% } %>
              <div><p class="eyebrow"><%= memberId %></p><h1><%= profile.first_name %> <%= profile.last_name %></h1><span class="status-badge <%= profile.membership_status %>"><%= profile.membership_status %></span></div>
            </div>
            <div class="profile-actions"><a class="primary-link" href="/member/profile/edit">Edit my profile</a><a class="text-link" href="/member/password">Change password</a></div>
          </section>
          <section class="content-card details-card" aria-labelledby="details-title">
            <h2 id="details-title">Profile and membership</h2>
            <dl class="details-grid">
              <div><dt>Email</dt><dd><%= profile.email %></dd></div>
              <div><dt>Birthdate</dt><dd><%= profile.birthdate %></dd></div>
              <div><dt>Age</dt><dd><%= age %></dd></div>
              <div><dt>Gender</dt><dd><%= profile.gender || 'Not provided' %></dd></div>
              <div><dt>Country</dt><dd><%= profile.country %></dd></div>
              <div><dt>City</dt><dd><%= profile.city %></dd></div>
              <div><dt>Favorite member</dt><dd><%= profile.favorite_member %></dd></div>
              <div><dt>Date joined</dt><dd><%= profile.date_joined %></dd></div>
              <div><dt>Membership status</dt><dd><%= profile.membership_status %></dd></div>
              <div class="full-width"><dt>Short bio</dt><dd><%= profile.short_bio || 'No bio added.' %></dd></div>
            </dl>
          </section>
        </main>
      </div>
    </div>
  </body>
</html>
