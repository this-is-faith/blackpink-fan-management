<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | BLACKPINK Fan Management System</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/members.css" />
  </head>
  <body class="dashboard-page">
    <div class="dashboard-layout">
      <%- include('../partials/admin-sidebar', { active: 'members' }) %>
      <div class="dashboard-content">
        <header class="dashboard-header"><span>Member management</span><span class="header-role">Admin</span></header>
        <main class="dashboard-main">
          <div class="page-heading">
            <div><p class="eyebrow">Community directory</p><h1>Members</h1><p>View and manage fan community profiles.</p></div>
            <a class="primary-link" href="/admin/members/new">Add member</a>
          </div>

          <section class="content-card" aria-label="Member list">
            <form class="search-form" action="/admin/members" method="get" role="search">
              <label for="member-search">Search by name, email, or member ID</label>
              <div class="search-row">
                <input id="member-search" name="q" type="search" value="<%= q %>" maxlength="100" placeholder="Search members" />
                <button type="submit">Search</button>
                <% if (q) { %><a class="text-link" href="/admin/members">Clear</a><% } %>
              </div>
            </form>

            <% if (members.length) { %>
              <div class="table-scroll">
                <table>
                  <thead><tr><th scope="col">Member ID</th><th scope="col">Name</th><th scope="col">Email</th><th scope="col">Favorite</th><th scope="col">Status</th><th scope="col">Joined</th><th scope="col"><span class="visually-hidden">Action</span></th></tr></thead>
                  <tbody>
                    <% members.forEach((member) => { %>
                      <tr>
                        <td><%= memberId(member.id) %></td>
                        <td class="name-cell"><%= member.first_name %> <%= member.last_name %></td>
                        <td><%= member.email %></td>
                        <td><%= member.favorite_member %></td>
                        <td><span class="status-badge <%= member.status %>"><%= member.status %></span></td>
                        <td><%= member.date_joined %></td>
                        <td><a class="text-link" href="/admin/members/<%= member.id %>">View</a></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="empty-state">
                <h2><%= q ? 'No matching members' : 'No members yet' %></h2>
                <p><%= q ? 'Try another name, email, or member ID.' : 'Add the first fan to start building your community.' %></p>
                <% if (!q) { %><a class="primary-link" href="/admin/members/new">Add your first member</a><% } %>
              </div>
            <% } %>
          </section>
        </main>
      </div>
    </div>
  </body>
</html>
